{
  "name": "pumpfun-trader-mcp",
  "version": "3.1.0",
  "description": "Hosted (Streamable HTTP) MCP server: pump.fun momentum scanner + risk-limited trading via PumpPortal",
  "type": "module",
  "main": "dist/http.js",
  "bin": {
    "pumpfun-trader-mcp": "dist/http.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/http.js",
    "start:stdio": "node dist/stdio.js",
    "gen-secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "preflight": "node --env-file=.env dist/preflight.js",
    "backtest": "node dist/backtest.js",
    "backtest:synthetic": "node scripts/make-synthetic-recording.mjs 6 data/synthetic && node dist/backtest.js --data data/synthetic --out backtest-results/synthetic"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "express": "^4.22.3",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.4"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "pump.fun",
    "solana",
    "trading-bot",
    "memecoin",
    "backtesting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/pumpfun-trader-mcp.git"
  }
}